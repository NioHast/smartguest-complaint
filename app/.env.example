# Konfigurasi penyedia LLM (server-side, jangan pakai NEXT_PUBLIC_*).
# AI_API_KEY wajib diisi. Tanpa key, klasifikasi tidak berjalan dan pencatatan
# keluhan ditolak dengan HTTP 503.
AI_API_KEY=
# Endpoint OpenAI-compatible. Default DeepSeek.
AI_BASE_URL=https://api.deepseek.com
# Model yang dipakai. Default deepseek-chat.
AI_MODEL=deepseek-chat
# Provider lain yang OpenAI-compatible: cukup ganti AI_BASE_URL dan AI_MODEL.

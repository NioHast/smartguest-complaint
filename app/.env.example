# Konfigurasi penyedia LLM (server-side, jangan pakai NEXT_PUBLIC_*).
# AI_API_KEY opsional. Tanpa key (atau bila AI gagal/timeout), keluhan tetap
# tersimpan sebagai "Perlu Ditinjau" dengan alasan yang menyebut penyebabnya.
AI_API_KEY=
# Endpoint OpenAI-compatible. Default DeepSeek.
AI_BASE_URL=https://api.deepseek.com
# Model yang dipakai. Default deepseek-chat.
AI_MODEL=deepseek-chat
# Provider lain yang OpenAI-compatible: cukup ganti AI_BASE_URL dan AI_MODEL.

# Basis URL publik aplikasi untuk halaman QR saat dipakai di jaringan/HTTPS
# (mis. http://192.168.1.10:3000). Bila kosong, /qr memakai x-forwarded-proto
# (bila ada) lalu header Host permintaan.
# NEXT_PUBLIC_BASE_URL=

# Mode seeding data demo saat database kosong (lihat README):
# static (default) = pakai nilai ai_* literal di src/lib/seed-data.ts, tanpa panggilan AI.
# ai              = pakai hasil beku di data/seed-ai.json; jalankan `npm run seed:ai` lebih dulu.
SEED_MODE=static

# Notifikasi Telegram (opsional). Tanpa token, notifikasi hanya dicatat di log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_HOUSEKEEPING=
TELEGRAM_CHAT_ENGINEERING=
TELEGRAM_CHAT_FNB=
TELEGRAM_CHAT_FRONT_OFFICE=
TELEGRAM_CHAT_DUTY_MANAGER=
# Opsional bila memakai grup ber-topik:
# TELEGRAM_THREAD_HOUSEKEEPING=
# TELEGRAM_THREAD_ENGINEERING=
# TELEGRAM_THREAD_FNB=
# TELEGRAM_THREAD_FRONT_OFFICE=
# TELEGRAM_THREAD_DUTY_MANAGER=

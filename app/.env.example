# Konfigurasi penyedia LLM (server-side, jangan pakai NEXT_PUBLIC_*).
# Isi AI_API_KEY dengan kunci API DeepSeek Anda. Biarkan kosong untuk memakai
# mode aturan kata kunci tanpa AI (aplikasi tetap berjalan normal).
AI_API_KEY=
# Endpoint OpenAI-compatible. Default DeepSeek.
AI_BASE_URL=https://api.deepseek.com
# Model yang dipakai. Default deepseek-chat.
AI_MODEL=deepseek-chat

# Kompatibilitas opsional dengan OpenAI (hanya dipakai bila AI_API_KEY kosong):
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
